# =============================================================================
# Wall King — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — PostgreSQL database
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service-role key — NEVER expose to the browser. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct Postgres connection string (used for migrations / direct queries)
DATABASE_URL=postgresql://postgres:<password>@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Admin Authentication
# A random secret (min 32 chars) used to protect all /api/admin/* routes.
# Include as Authorization: Bearer <ADMIN_SECRET> header, or set cookie.
# Generate one: openssl rand -base64 32
# -----------------------------------------------------------------------------
ADMIN_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# -----------------------------------------------------------------------------
# Meta WhatsApp Business Cloud API
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# -----------------------------------------------------------------------------

# A string YOU choose when registering the webhook in Meta Developer Console.
# Must match what you enter in: App Dashboard → WhatsApp → Configuration → Webhook Verify Token
META_VERIFY_TOKEN=your-random-webhook-verify-token

# App Secret — from App Dashboard → Settings → Basic → App Secret
META_APP_SECRET=your-meta-app-secret

# Permanent system user access token from Meta Business Manager
# (or a temporary token for development)
META_WA_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx

# WhatsApp Phone Number ID — from App Dashboard → WhatsApp → API Setup
META_WA_PHONE_NUMBER_ID=123456789012345

# Graph API version (check https://developers.facebook.com/docs/graph-api/changelog for latest stable)
META_GRAPH_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# Application URL (used for webhook self-reference in admin panel)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://wallking.in
